{
  "name": "dsh-session-groups",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DSH Web plugin: Edge-style session groups with workspace tree, single list, recursive sorting and dark-mode palettes.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "session-groups",
    "sidebar",
    "edge-tabs",
    "tab-groups",
    "workspace-tree",
    "pinyin-sort",
    "dark-mode"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  }
}
